# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# DeepSeek 模型（可选，默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# PubMed 查询所需的邮箱（NCBI 要求提供，必填）
PUBMED_EMAIL=you@example.com

# 可选：NCBI E-utilities API Key（无则按匿名限额 3 次/秒）
NCBI_API_KEY=

# 可选：最近 N 天内发表的综述（默认 5）
LOOKBACK_DAYS=5

# 可选：每日检索返回候选数（默认 30）
RETMAX=30

# 可选：是否提交 git（CI 中自动开启；本地默认 false，用 --commit 开启）
GIT_COMMIT=false

# 可选：精读时最大喂给 LLM 的原文字符数（默认 60000，提高后可覆盖更长全文）
MAX_TEXT_CHARS=60000

# 可选：保留最近 N 天的精读文件（默认 0，即每天只保留当天文章，第二天自动清除前一天）
KEEP_DAYS=0

# ===== 每日考研词汇（可选）=====
# 可选：每天生成多少个单词（默认 15）
VOCAB_PER_DAY=15

# 可选：从词频表第几个词开始（默认 0，即从最高频开始）
VOCAB_START=0

# 可选：跳过的基础词（逗号分隔，覆盖默认跳过列表；默认跳过 the/a/to 等纯功能词）
VOCAB_SKIP_WORDS=